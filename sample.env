# ---------- Discord ----------
DISCORD_BOT_TOKEN="DISCORD DEVELOPERS"
DISCORD_CHANNEL_ID="DISCORD APP/WEB - ONLY DEV MODE"

# ---------- Zkool GraphQL ----------
# Mantenha o zkool-graphql escutando só em 127.0.0.1. Fora de localhost, use https.
# Com deploy/zkool-zeca.service (zkool exclusivo do ZECA), a porta é 8001.
# Não aponte o ZECA para um zkool usado por outro serviço: a API do zkool não
# isola contas, então um ZECA comprometido leria as chaves dos outros.
GQL_URL=http://127.0.0.1:8000/graphql
# Opcional: token Bearer, se houver um proxy autenticado na frente do zkool
GQL_AUTH_TOKEN=
# Só "true" se souber o que está fazendo: permite http:// fora de localhost
ALLOW_INSECURE_GQL=false
# Instalações que já rodavam: informe o id da conta existente no zkool (normalmente 1)
# Vazio: o bot usa o id salvo no banco ou importa a UFVK na primeira execução.
ZKOOL_ACCOUNT_ID=
# Timeouts das chamadas ao zkool (ms). Sem eles, um zkool travado segura o bot.
GQL_TIMEOUT_MS=30000
GQL_SYNC_TIMEOUT_MS=120000

# ---------- Carteira ----------
# UFVK (uview1...). Nunca coloque seed ou chave de gasto aqui.
VK="UFVK OF YOUR WALLET"
# Bloco de nascimento da carteira
BIRTH_HEIGHT=3170000

# ---------- Comportamento ----------
CONFIRMATIONS=6
POLL_INTERVAL=60
# Valor mínimo (em zatoshis) para publicar um memo. 10000 = 0.0001 ZEC. Anti-spam.
MIN_VALUE_ZAT=0
# Máximo de memos publicados por ciclo (anti-flood)
MAX_POSTS_PER_CYCLE=10
# Remove endereços Zcash colados no memo (protege o remetente)
STRIP_ADDRESSES_FROM_MEMO=true
# true = mostra o valor na mensagem, false = oculta
DEFAULT_SHOW_VALUE=false

# ---------- Armazenamento ----------
# Com deploy/zeca.service: /var/lib/zeca/database.sqlite e /var/log/zeca/bot.log
BOT_DB_PATH=./database.sqlite
LOG_FILE=bot.log
LOG_MAX_MB=10